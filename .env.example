# SQL Server connection used by the .NET host.
ConnectionStrings__LibraryDb=Server=.\SQLEXPRESS01;Database=LibraryDb;Trusted_Connection=True;TrustServerCertificate=True

# Sample rows are hidden by default. Set to true only for demos.
INCLUDE_SAMPLE_DATA=false

# Used by the Open Library seed command.
OPEN_LIBRARY_TARGET_COUNT=1000

# Open Library identifies clients by User-Agent. Replace the placeholder locally.
OpenLibrary__ContactEmail=your-email@example.com
OpenLibrary__RefreshDays=30
OpenLibrary__EnableBackgroundRefresh=false
OpenLibrary__BatchSize=25
OpenLibrary__MaxConsecutiveErrors=3
